#!/home/jackgorman/.local/share/ditoo/venv/bin/python
"""Turn any picture or GIF into 16x16 pixel art for the Ditoo Pro.

Cuts the subject out of its background (rembg), crops to it, punches up colour
for LEDs, shrinks to 16x16 and reduces the palette so it reads as pixel art.
Results land in ~/Pictures/ditoo/ as NAME.png or NAME.gif (16x16) plus a
NAME_preview copy scaled up 20x.

  ditoo-picture PHOTO...                convert and show the last one on the speaker
  ditoo-picture PHOTO --store [SLOT]    convert and save onto the speaker itself
  options:
    --keep-bg        don't remove the background
    --bg R,G,B       colour behind the cut-out subject (default black = LEDs off)
    --colors N       palette size (default 16)
    --margin N       empty pixels around the subject (default 1)
    --top F          keep only the top fraction F of the subject (0.45 = head and
                     shoulders), for full-body figures too thin to read at 16x16
    --no-show        only write the files
"""
import os, sys
from importlib.machinery import SourceFileLoader
import numpy as np
from PIL import Image, ImageEnhance, ImageOps, ImageSequence

screen = SourceFileLoader("ditoo_screen", os.path.expanduser("~/.local/bin/ditoo-screen")).load_module()
OUT = os.path.expanduser("~/Pictures/ditoo")
SIZE = 16
MAX_FRAMES = 60  # the speaker's animation size limit, as in ditoo-screen


def cut_out(img):
    from scipy import ndimage
    px = np.asarray(img)
    corners = px[[0, 0, -1, -1], [0, -1, 0, -1]]
    if (corners[:, 3] < 255).all():
        return img  # already cut out
    if np.abs(corners[:, :3].astype(int) - corners[0, :3]).max() <= 8:
        # Plain backdrop (renders, logos): key out only backdrop-coloured pixels
        # connected to the border, so enclosed details of that colour (eyes) stay.
        near = np.abs(px[..., :3].astype(int) - corners[0, :3]).max(axis=2) <= 24
        labels, _ = ndimage.label(near)
        border = np.unique(np.concatenate([labels[0], labels[-1], labels[:, 0], labels[:, -1]]))
        backdrop = np.isin(labels, border[border > 0])
        out = img.copy()
        out.putalpha(Image.fromarray(np.where(backdrop, 0, 255).astype(np.uint8)))
        return out

    from rembg import new_session, remove  # slow import; only for real photos
    global _session
    if "_session" not in globals():
        _session = new_session("isnet-general-use")
    # Only the mask: rembg's own cut-out also darkens half-transparent pixels,
    # which turns thin white eyes grey.
    alpha = np.asarray(remove(img, session=_session, only_mask=True).convert("L")).copy()
    out = img.copy()
    # Light details enclosed by the subject (white eyes on a white backdrop) come
    # back half-transparent. Small enclosed holes the model was unsure about are
    # part of the subject; a clear one (the gap between legs) is real background.
    solid = alpha > 128
    holes, n = ndimage.label(ndimage.binary_fill_holes(solid) & ~solid)
    if n:
        labels = range(1, n + 1)
        sizes = ndimage.sum(np.ones_like(holes), holes, labels)
        unsure = ndimage.mean(alpha, holes, labels) > 40
        keep = 1 + np.flatnonzero((sizes < 0.02 * solid.sum()) & unsure)
        alpha[np.isin(holes, keep)] = 255
    out.putalpha(Image.fromarray(alpha))
    return out


def is_flat(square):
    """Logos and cartoons: a handful of colours cover nearly all of the subject."""
    small = np.asarray(square.resize((64, 64), Image.NEAREST))
    fg = small[small[..., 3] > 128][:, :3] // 24
    if len(fg) == 0:
        return False
    _, counts = np.unique(fg, axis=0, return_counts=True)
    return np.sort(counts)[::-1][:6].sum() >= 0.9 * len(fg)


def on_bg(square, bg):
    flat = Image.new("RGB", square.size, bg)
    flat.paste(square.convert("RGB"), mask=square.getchannel("A").point(lambda a: 255 if a > 128 else 0))
    return flat


def enhance(square):
    """LEDs wash out mid-tones; push saturation and contrast before shrinking."""
    rgb = ImageEnhance.Color(square.convert("RGB")).enhance(1.5)
    rgb = ImageEnhance.Contrast(rgb).enhance(1.2)
    return Image.merge("RGBA", (*rgb.split(), square.getchannel("A")))


def shared_palette(squares, bg, colors):
    """One palette for every frame, so colours don't flicker through an animation."""
    tile = 96
    sheet = Image.new("RGB", (tile * len(squares), tile), bg)
    for i, sq in enumerate(squares):
        sheet.paste(on_bg(sq.resize((tile, tile), Image.NEAREST), bg), (i * tile, 0))
    return sheet.quantize(colors, method=Image.Quantize.MEDIANCUT, dither=Image.Dither.NONE)


def flat_palette(squares, bg, colors):
    """Shared palette for flat art from full-resolution pixels, so small solid
    features (eyes) get their own entry instead of vanishing in a downscale.
    Anti-aliased edges scatter over many buckets; a feature fills one."""
    picks = squares[::max(1, len(squares) // 8)]
    px = np.concatenate([np.asarray(sq)[np.asarray(sq)[..., 3] > 128][:, :3] for sq in picks])
    keys, inverse, counts = np.unique(px // 32, axis=0, return_inverse=True, return_counts=True)
    top = np.argsort(counts)[::-1][:colors - 1]
    top = [k for k in top if counts[k] >= 0.002 * len(px)]
    entries = [tuple(bg)] + [tuple(int(v) for v in px[inverse.ravel() == k].mean(axis=0)) for k in top]
    flat = [v for rgb in entries for v in rgb]
    palette = Image.new("P", (1, 1))
    palette.putpalette(flat + flat[:3] * (256 - len(entries)))  # pad with bg, not stray black
    return palette


def shrink_flat(square, inner, bg, palette):
    """Pick a real colour per block instead of averaging, so edges stay crisp and
    small contrasting features (eyes, outlines) survive the shrink."""
    q = on_bg(square, bg).quantize(palette=palette, dither=Image.Dither.NONE)
    idx = np.asarray(q)
    pal = np.array(q.getpalette()[:3 * 256]).reshape(-1, 3)
    clear = np.asarray(square.getchannel("A")) <= 128
    bg_idx = np.bincount(idx[clear]).argmax() if clear.any() else -1
    subject = idx[~clear] if (~clear).any() else idx.ravel()
    main_idx = np.bincount(subject).argmax()
    # Anti-aliased edges quantise into near-copies of the main colour; fold them back.
    near = np.abs(pal - pal[main_idx]).sum(axis=1) < 90
    if bg_idx >= 0:
        near[bg_idx] = False
    idx = np.where(near[idx], main_idx, idx)

    edges = np.linspace(0, idx.shape[0], inner + 1).astype(int)
    out = Image.new("RGB", (inner, inner), bg)
    for y in range(inner):
        for x in range(inner):
            block = idx[edges[y]:edges[y + 1], edges[x]:edges[x + 1]].ravel()
            counts = np.bincount(block, minlength=len(pal))
            share = counts / counts.sum()
            pick = counts.argmax()
            features = [c for c in np.argsort(share)[::-1] if c not in (main_idx, bg_idx) and share[c] >= 0.3]
            if features:
                pick = features[0]
            elif pick == bg_idx and main_idx != bg_idx and share[main_idx] >= 0.4:
                pick = main_idx
            out.putpixel((x, y), bg if pick == bg_idx else tuple(int(v) for v in pal[pick]))

    # Shapes in a colour far from both body and background (white eyes on orange)
    # are the character's features. One too small to win any block above still
    # gets a pixel at its centre, and two landing on the same pixel are spread
    # apart, so every frame of an animation shows the same pair of eyes.
    from scipy import ndimage
    bg_rgb = np.array(bg)
    stark = (np.abs(pal - pal[main_idx]).sum(axis=1) > 300) & (np.abs(pal - bg_rgb).sum(axis=1) > 300)
    scale = idx.shape[0] / inner
    taken = {}
    for colour in np.flatnonzero(stark):
        labels, n = ndimage.label(idx == colour)
        ones = np.ones_like(labels)
        sizes = ndimage.sum(ones, labels, range(1, n + 1))
        centres = ndimage.center_of_mass(ones, labels, range(1, n + 1))
        if np.sum(sizes >= (scale * scale) * 0.05) > 4:
            continue  # many shapes in this colour is linework (joints, outlines), not eyes
        for size, (cy, cx) in zip(sizes, centres):
            if size < (scale * scale) * 0.05:
                continue  # speck, not a feature
            x, y = min(inner - 1, int(cx / scale)), min(inner - 1, int(cy / scale))
            if out.getpixel((x, y)) == tuple(int(v) for v in pal[colour]) and (x, y) not in taken:
                taken[(x, y)] = cx
                continue  # already drawn by its own footprint
            if (x, y) in taken:
                x = min(inner - 1, x + 1) if cx >= taken[(x, y)] else max(0, x - 1)
            taken[(x, y)] = cx
            out.putpixel((x, y), tuple(int(v) for v in pal[colour]))
    return out


def shrink_photo(square, inner, bg, palette):
    small = square.resize((inner, inner), Image.LANCZOS)
    alpha = small.getchannel("A").point(lambda a: 255 if a > 110 else 0)
    flat = on_bg(Image.merge("RGBA", (*small.convert("RGB").split(), alpha)), bg)
    flat = flat.quantize(palette=palette, dither=Image.Dither.NONE).convert("RGB")
    flat.paste(bg, mask=alpha.point(lambda a: 255 - a))  # keep the background exact after quantising
    return flat


def load_frames(path):
    with Image.open(path) as src:
        frames = [(ImageOps.exif_transpose(f.copy()).convert("RGBA"), f.info.get("duration") or 100)
                  for f in ImageSequence.Iterator(src)]
    if len(frames) <= MAX_FRAMES:
        return frames
    # Thin out evenly; each kept frame lasts as long as the ones it stands in for.
    picks = [i * len(frames) // MAX_FRAMES for i in range(MAX_FRAMES)] + [len(frames)]
    return [(frames[a][0], sum(ms for _, ms in frames[a:b])) for a, b in zip(picks, picks[1:])]


def convert(path, keep_bg=False, bg=(0, 0, 0), colors=16, margin=1, top=1.0):
    """Returns [(16x16 RGB image, duration ms)], one entry per frame."""
    frames = load_frames(path)
    images = [img for img, _ in frames]
    if not keep_bg:
        images = [cut_out(img) for img in images]
        # One crop for all frames, so the subject doesn't jitter.
        boxes = [b for img in images if (b := img.getchannel("A").point(lambda a: 255 if a > 40 else 0).getbbox())]
        if boxes:
            box = (min(b[0] for b in boxes), min(b[1] for b in boxes),
                   max(b[2] for b in boxes), max(b[3] for b in boxes))
            if top < 1:
                # Square portrait round the head: outstretched arms run off the
                # edge instead of shrinking everything to fit.
                h = round(top * (box[3] - box[1]))
                cols = [np.flatnonzero(np.asarray(img.getchannel("A"))[box[1]:box[1] + h].max(axis=0) > 40)
                        for img in images]
                cx = int(np.median([(c[0] + c[-1]) / 2 for c in cols if len(c)]))
                box = (cx - h // 2, box[1], cx - h // 2 + h, box[1] + h)
            images = [img.crop(box) for img in images]

    # Square canvas so the subject is not stretched.
    side = max(images[0].size)
    squares = []
    for img in images:
        square = Image.new("RGBA", (side, side), (0, 0, 0, 0))
        square.paste(img, ((side - img.width) // 2, (side - img.height) // 2))
        squares.append(square)

    inner = SIZE - 2 * margin
    if is_flat(squares[0]):
        palette = flat_palette(squares, bg, min(colors, 8))
        small = [shrink_flat(sq, inner, bg, palette) for sq in squares]
    else:
        squares = [enhance(sq) for sq in squares]
        palette = shared_palette(squares, bg, colors)
        small = [shrink_photo(sq, inner, bg, palette) for sq in squares]

    result = []
    for img, (_, ms) in zip(small, frames):
        out = Image.new("RGB", (SIZE, SIZE), bg)
        out.paste(img, (margin, margin))
        result.append((out, ms))
    return result


def save(frames, name):
    scaled = [img.resize((SIZE * 20, SIZE * 20), Image.NEAREST) for img, _ in frames]
    if len(frames) == 1:
        path = os.path.join(OUT, name + ".png")
        frames[0][0].save(path)
        scaled[0].save(os.path.join(OUT, name + "_preview.png"))
        return path
    path = os.path.join(OUT, name + ".gif")
    durations = [ms for _, ms in frames]
    for imgs, target in (([img for img, _ in frames], path), (scaled, os.path.join(OUT, name + "_preview.gif"))):
        imgs[0].save(target, save_all=True, append_images=imgs[1:], duration=durations, loop=0, disposal=1)
    return path


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    opts, paths, i = {}, [], 0
    while i < len(argv):
        a = argv[i]
        if a in ("--bg", "--colors", "--margin", "--top"):
            opts[a] = argv[i + 1]
            i += 2
        elif a == "--store":
            nxt = argv[i + 1] if i + 1 < len(argv) else ""
            opts[a] = int(nxt) if nxt.isdigit() else 0
            i += 2 if nxt.isdigit() else 1
        elif a.startswith("--"):
            opts[a] = True
            i += 1
        else:
            paths.append(a)
            i += 1

    bg = tuple(int(x) for x in opts["--bg"].split(",")) if "--bg" in opts else (0, 0, 0)
    os.makedirs(OUT, exist_ok=True)
    results = []
    for path in paths:
        frames = convert(path, "--keep-bg" in opts, bg, int(opts.get("--colors", 16)),
                         int(opts.get("--margin", 1)), float(opts.get("--top", 1.0)))
        print(save(frames, os.path.splitext(os.path.basename(path))[0]))
        results.append(frames)

    if "--store" in opts or "--no-show" not in opts:
        d = screen.Ditoo()
        try:
            if "--store" in opts:
                d.store([frame for frames in results for frame in frames], opts["--store"])
                d.gallery(opts["--store"])
            else:
                d.frames(results[-1])
        finally:
            d.close()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
